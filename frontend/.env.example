# Production Environment Variables for Vercel
# Point to your central Nginx API Gateway URL:

# REST API endpoint for Auth Service (Routed by Nginx to Render Account 1)
VITE_API_URL=https://api.yourdomain.com/api/v1/auth

# WebSocket Signaling endpoint (Routed by Nginx to Render Account 2)
VITE_WS_URL=wss://api.yourdomain.com/ws
